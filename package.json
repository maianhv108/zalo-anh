{
  "name": "sales-zalo-management",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sales-zalo/web --filter @sales-zalo/api dev",
    "dev:api": "pnpm --filter @sales-zalo/api dev",
    "dev:web": "pnpm --filter @sales-zalo/web dev",
    "build:shared": "pnpm --filter @sales-zalo/shared build",
    "db:migrate": "pnpm --filter @sales-zalo/api prisma:migrate",
    "db:seed": "pnpm --filter @sales-zalo/api seed",
    "db:generate": "pnpm --filter @sales-zalo/api prisma:generate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "node scripts/test-e2e-all-phases.mjs",
    "test:qr": "node scripts/test-qr-invite-flow.mjs",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "devDependencies": {}
}
