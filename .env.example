# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_zalo_dev?schema=public

# Generate a strong random value for local use; never reuse production secrets.
SESSION_SECRET=replace_with_a_long_random_local_secret
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Optional storage configuration; use local storage only for development.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Google Cloud Service Account credentials (for Google Sheets & Drive Read-Only API)
# Đặt đường dẫn tuyệt đối đến file JSON tải từ Google Cloud:
# Ví dụ Windows: GOOGLE_APPLICATION_CREDENTIALS=C:/Users/ASUS/Downloads/tool-zalo-tourluk-xxxx.json
# hoặc: GOOGLE_APPLICATION_CREDENTIALS=D:/sales-zalo-project-docs/secrets/tool-zalo-tourluk.json
GOOGLE_APPLICATION_CREDENTIALS=

# Do not add personal Zalo passwords, OTPs, cookies, or session tokens here.
